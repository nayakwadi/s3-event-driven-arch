        <mxCell id="e3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;fontColor=#232F3E;fontSize=11;" target="sqs" value="3  s3:ObjectCreated:*&#xa;prefix = sqs/">
          <mxGeometry relative="1" x="0.0052" y="-20" as="geometry">

            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;fontColor=#232F3E;fontSize=11;" value="2  s3:ObjectRemoved:*">
          <mxGeometry relative="1" x="0.2083" y="-10" as="geometry">

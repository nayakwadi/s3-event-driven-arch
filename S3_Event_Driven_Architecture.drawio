        <mxCell id="e4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;fontColor=#232F3E;fontSize=11;" value="4  all events (bucket toggle)">

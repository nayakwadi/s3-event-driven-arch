        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#545B64;" value="One S3 bucket fans out along four trigger paths into a single message-printer Lambda, which logs the detected source." vertex="1">
